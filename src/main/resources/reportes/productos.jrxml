<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="productos" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
  <property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
  <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>
  <parameter name="titulo" class="java.lang.String"/>
  <field name="id" class="java.lang.Long"/><field name="nombre" class="java.lang.String"/><field name="marca" class="java.lang.String"/>
  <field name="categoria" class="java.lang.String"/><field name="precio" class="java.lang.Double"/><field name="cantidad" class="java.lang.Integer"/>
  <variable name="valorTotal" class="java.lang.Double" calculation="Sum"><variableExpression><![CDATA[Double.valueOf($F{precio} * $F{cantidad})]]></variableExpression></variable>
  <title><band height="50"><textField><reportElement x="0" y="0" width="555" height="30" forecolor="#1F3864"/><textElement textAlignment="Center"><font size="16" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression></textField></band></title>
  <columnHeader><band height="22">
    <staticText><reportElement mode="Opaque" x="0" y="0" width="40" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><text><![CDATA[ID]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="40" y="0" width="145" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><text><![CDATA[Nombre]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="185" y="0" width="110" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><text><![CDATA[Marca]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="295" y="0" width="100" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><text><![CDATA[Categoría]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="395" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><textElement textAlignment="Right"/><text><![CDATA[Precio]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="475" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/><textElement textAlignment="Right"/><text><![CDATA[Stock]]></text></staticText>
  </band></columnHeader>
  <detail><band height="20">
    <textField><reportElement x="0" y="0" width="40" height="20"/><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
    <textField><reportElement x="40" y="0" width="145" height="20"/><textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression></textField>
    <textField><reportElement x="185" y="0" width="110" height="20"/><textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression></textField>
    <textField><reportElement x="295" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
    <textField pattern="#,##0.00"><reportElement x="395" y="0" width="80" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression></textField>
    <textField><reportElement x="475" y="0" width="80" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
  </band></detail>
  <summary><band height="30">
    <staticText><reportElement x="295" y="8" width="180" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Valor total S/]]></text></staticText>
    <textField pattern="#,##0.00"><reportElement x="475" y="8" width="80" height="20"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{valorTotal}]]></textFieldExpression></textField>
  </band></summary>
</jasperReport>
